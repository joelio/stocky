# Stocky MCP Server — example configuration
#
# Stocky reads configuration from its environment. It does NOT load this file
# on its own: MCP clients start the server as a subprocess and pass these
# through the "env" block of the client configuration.
#
# Copy to .env for local development (demo.py and the integration tests), and
# source it yourself:  set -a && . ./.env && set +a

# --- Providers (at least one is required) ---------------------------------

# Pexels API key — https://www.pexels.com/api/
# Note: Pexels returns HTTP 200 even for an invalid key, so a typo here will
# look like it works. Verify separately if results seem wrong.
PEXELS_API_KEY=your_pexels_api_key_here

# Unsplash access key — https://unsplash.com/developers
# New applications start in demo mode at 50 requests/hour. Apply for
# production access to raise it to 1000/hour.
UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here

# --- Behaviour (all optional) ---------------------------------------------

# Include attribution text and HTML with every result. Both providers require
# attribution as a condition of API access, so enable this if you display
# images anywhere.
ENABLE_ATTRIBUTION_LINKS=false

# Search cache lifetime in seconds. 0 disables caching entirely.
STOCKY_CACHE_TTL=300

# Per-request timeout in seconds for provider API calls.
STOCKY_HTTP_TIMEOUT=15

# Refuse downloads larger than this many bytes (default 25 MiB).
STOCKY_MAX_DOWNLOAD_BYTES=26214400

# Confine all downloads to this directory. Recommended: download paths come
# from model-generated tool calls, and this stops writes escaping elsewhere.
# STOCKY_DOWNLOAD_ROOT=/Users/you/Pictures/stocky

# DEBUG, INFO, WARNING or ERROR. Logs always go to stderr, never stdout.
STOCKY_LOG_LEVEL=INFO

# User-Agent sent to providers. Pexels rejects requests without one.
# STOCKY_USER_AGENT=stocky-mcp
